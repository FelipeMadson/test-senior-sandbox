#!/usr/bin/env sh
# Conventional Commits Validator Hook
commit_msg=$(cat "$1")
pattern="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(([a-zA-Z0-9_.-]+))?: .{1,100}"
if ! echo "$commit_msg" | grep -Eq "$pattern"; then
  echo "❌ ERRO: Mensagem de commit não segue o padrão Conventional Commits!"
  echo "Exemplo: feat(domain): implement core models and value objects"
  exit 1
fi
exit 0
